# ============================================
# POMBO RELAY CONFIGURATION
# ============================================
# Copy this file to .env and fill in the values

# Ethereum private key for the relay (generate a new one!)
# Can be any wallet, no funds needed
# Generate with: npm run generate-keys
RELAY_PRIVATE_KEY=0x...

# VAPID keys (generated with npm run generate-keys)
# Required for Web Push (FCM/APNS)
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_EMAIL=admin@example.com

# Push notifications stream (MUST match with clients!)
# This is the live Pombo push stream — do not change it unless
# you know what you are doing
PUSH_STREAM_ID=0xae340e799e8151f6a4999d245e466197aa217667/push

# Proof-of-Work difficulty (4 = hash starts with 0000, ~200ms)
# Increase if there's spam, decrease if clients are weak
POW_DIFFICULTY=4

# Admin API port (optional, default 8000)
# Set to 0 to disable
ADMIN_PORT=8000

# OPTIONAL: native FCM push for the Android app.
# Path to (or inline JSON of) a Firebase service-account key.
# This key is a secret — keep it OUTSIDE this folder and never commit it.
# Without it, the relay serves Web Push clients as usual.
# FCM_SERVICE_ACCOUNT=/path/to/service-account.json
